# ===============================
# Backend specific ignores
# ===============================

# Python virtual environments
/backend/.venv/
/backend/.venv_tf/
/training/.venv/
.venv/
.venv_tf/
venv/
env/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyTest cache
.pytest_cache/
.coverage
htmlcov/

# Environment files (contains API keys and secrets)
.env
/backend/app/.env
*.env

# ===============================
# ML Model files (biasanya besar dan bisa didownload/retrain)
# ===============================

# Model files - biasanya besar, bisa didownload terpisah
/backend/model/*.h5
/backend/model/*.pkl
/backend/model/*.joblib
/backend/model/*.pt
/backend/model/*.pth
/backend/model/*.onnx
/backend/model/*.tflite
/backend/model/labels.txt

# Training artifacts
/training/runs/
/training/logs/
/training/checkpoints/
/training/output/
/training/weights/

# ===============================
# Dataset files - biasanya besar dan personal/licensed
# ===============================

# Dataset folders
/training/dataset/
/data/
/datasets/
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.webp

# Kecuali sample/demo images kecil (uncomment jika ada)
# !/assets/demo/*.jpg
# !/frontend/public/images/*.png

# ===============================
# Debug dan temporary files
# ===============================

# Debug scripts yang dibuat temporary
